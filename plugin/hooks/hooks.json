{
  "description": "Tell the session when this host's agent-state checkout is behind origin, or when a host copy drifted from it. Nothing here writes to Git.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-behind.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-behind.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
