{
  "name": "agent-state",
  "version": "0.1.0",
  "description": "Git-backed configuration shared by pi, Claude Code and Mistral Vibe, with a cross-host renderer and a Claude Code plugin",
  "license": "MIT",
  "author": "DragonL57",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "claude-code",
    "claude-code-plugin",
    "vibe",
    "mistral-vibe",
    "configuration",
    "dotfiles",
    "git",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DragonL57/agent-state.git"
  },
  "bugs": {
    "url": "https://github.com/DragonL57/agent-state/issues"
  },
  "files": [
    "extensions/pi-state/",
    "plugin/",
    ".claude-plugin/",
    "tools/state.py",
    "hosts/",
    "rig/agents/",
    "rig/skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-state/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
